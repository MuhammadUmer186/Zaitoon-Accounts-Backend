generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                 String               @id @default(cuid())
  name               String
  tradeName          String?
  registrationNo     String?
  vatNumber          String?
  email              String?
  phone              String?
  address            String?
  city               String?
  country            String               @default("SA")
  currency           String               @default("SAR")
  fiscalYearStart    String               @default("01-01")
  logoUrl            String?
  lowStockThreshold  Float?
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  branches           Branch[]
  users              User[]
  accounts           Account[]
  roles              Role[]
  dailySales         DailySale[]
  cashClosings       CashClosing[]
  expenses           Expense[]
  expenseCategories  ExpenseCategory[]
  suppliers          Supplier[]
  bills              Bill[]
  items              Item[]
  journalEntries     JournalEntry[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  documents          Document[]
  purchaseOrders     PurchaseOrder[]
  itemCategories     ItemCategory[]
  bankAccounts       BankAccount[]
  taxRates           TaxRate[]
  accountingMappings AccountingMapping[]
  accountingPeriods  AccountingPeriod[]
}

model Branch {
  id             String             @id @default(cuid())
  organizationId String
  name           String
  code           String
  city           String?
  address        String?
  phone          String?
  email          String?
  managerUserId  String?
  vatEnabled     Boolean            @default(true)
  vatRate        Float              @default(15)
  invoicePrefix  String             @default("INV")
  salePrefix     String             @default("SL")
  expensePrefix  String             @default("EXP")
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id])
  dailySales     DailySale[]
  cashClosings   CashClosing[]
  expenses       Expense[]
  bills          Bill[]
  branchStocks   BranchStock[]
  stockMovements StockMovement[]
  wastageReports WastageReport[]
  journalEntries JournalEntry[]
  userAccess     UserBranchAccess[]
  targets        BranchTarget[]
  purchaseOrders PurchaseOrder[]
  bankAccounts   BankAccount[]

  @@unique([organizationId, code])
}

model BranchTarget {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String
  year           Int
  month          Int
  salesTarget    Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  branch         Branch   @relation(fields: [branchId], references: [id])

  @@unique([branchId, year, month])
}

model User {
  id             String             @id @default(cuid())
  organizationId String
  email          String
  passwordHash   String
  firstName      String
  lastName       String
  phone          String?
  avatarUrl      String?
  isActive       Boolean            @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id])
  roles          UserRole[]
  branchAccess   UserBranchAccess[]
  refreshTokens  RefreshToken[]
  notifications  Notification[]

  @@unique([organizationId, email])
}

model Role {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  displayName    String
  description    String?
  isSystemRole   Boolean          @default(false)
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id])
  permissions    RolePermission[]
  userRoles      UserRole[]

  @@unique([organizationId, name])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  module      String
  description String?
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model UserBranchAccess {
  id             String  @id @default(cuid())
  userId         String
  organizationId String
  branchId       String
  canView        Boolean @default(true)
  canCreate      Boolean @default(true)
  canApprove     Boolean @default(false)
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch         Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────
// Chart of Accounts
// ─────────────────────────────────────────────────────────────────────────

// AccountClass and NormalBalance are intentionally plain String columns, not
// native Postgres enums (see src/types/accounting.ts for the TS-level union
// types) — this schema is production-migrated with `prisma db push` only (no
// custom migration files), which cannot express the USING-cast required to
// convert an existing populated String column to a native enum without data
// loss. Every other new enum below backs either a brand-new column with a
// default or an entirely new table, so it carries no such risk.

enum AccountStatus {
  ACTIVE
  ARCHIVED
}

enum AccountingPeriodStatus {
  OPEN
  LOCKED
  CLOSED
}

enum TaxRateType {
  INPUT
  OUTPUT
  BOTH
  EXEMPT
}

// Well-known accounting roles that operational modules (sales, expenses,
// bills, wastage, cash closing...) post against. Resolved through
// AccountingMapping at posting time instead of a hardcoded account code, so
// an org can point "Sales Revenue" at whichever account they actually use.
enum AccountingMappingKey {
  CASH_ON_HAND
  DEFAULT_BANK
  CARD_CLEARING
  ACCOUNTS_RECEIVABLE
  ACCOUNTS_PAYABLE
  INVENTORY
  SALES_REVENUE
  OTHER_INCOME
  COST_OF_SALES
  DEFAULT_EXPENSE
  INPUT_VAT
  OUTPUT_VAT
  WASTAGE_EXPENSE
  CASH_OVER_SHORT
  RETAINED_EARNINGS
  OPENING_BALANCE_EQUITY
}

// Organization-level chart of accounts (never per-branch — branch scoping
// lives on JournalEntry so balances/reports can still be filtered by branch).
// Balances are never stored here; they are always derived from posted
// JournalLine rows (see accounts.ts /:id/balance and /:id/ledger).
model Account {
  id                 String        @id @default(cuid())
  organizationId     String
  branchId           String?
  code               String
  name               String
  description        String?
  accountClass       String        @map("accountType")
  reportingGroup     String?
  accountSubtype     String?
  normalBalance      String
  parentId           String?
  isHeader           Boolean       @default(false)
  isSystem           Boolean       @default(false)
  isControlAccount   Boolean       @default(false)
  allowManualPosting Boolean       @default(true)
  status             AccountStatus @default(ACTIVE)
  defaultTaxRateId   String?
  archivedAt         DateTime?
  archivedById       String?
  createdById        String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @default(now()) @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id])
  parent       Account?            @relation("AccountChildren", fields: [parentId], references: [id])
  children     Account[]           @relation("AccountChildren")
  journalLines JournalLine[]
  taxRate      TaxRate?            @relation(fields: [defaultTaxRateId], references: [id])
  bankAccount  BankAccount?
  mappings     AccountingMapping[]

  @@unique([organizationId, code])
  @@index([organizationId, accountClass])
  @@index([organizationId, status])
  @@index([parentId])
}

// A bank account is always backed 1:1 by an ASSET leaf Account that actually
// receives postings — this row only carries the bank-specific metadata
// (masked identifiers, branch assignment). Never store full account numbers
// or IBANs; only masked values / last 4 digits.
model BankAccount {
  id                  String    @id @default(cuid())
  organizationId      String
  accountId           String    @unique
  branchId            String?
  bankName            String
  accountTitle        String
  accountNumberMasked String
  accountNumberLast4  String
  ibanMasked          String?
  currency            String
  openingDate         DateTime?
  isDefault           Boolean   @default(false)
  isActive            Boolean   @default(true)
  createdById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  account      Account      @relation(fields: [accountId], references: [id])
  branch       Branch?      @relation(fields: [branchId], references: [id])

  @@index([organizationId])
}

// Only a default selection for future transactions — changing an account's
// default tax rate must never alter historical journal entries or VAT
// reports, since those already captured their own amounts at posting time.
model TaxRate {
  id             String      @id @default(cuid())
  organizationId String
  name           String
  code           String
  rate           Decimal     @db.Decimal(6, 3)
  type           TaxRateType
  isDefault      Boolean     @default(false)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  accounts     Account[]

  @@unique([organizationId, code])
}

// Points a well-known operational posting role (AccountingMappingKey) at
// whichever Account the org has actually configured for it. Operational
// posting code resolves through this instead of silently creating/guessing
// an account — see resolveMappedAccount() in ledger.ts.
model AccountingMapping {
  id             String               @id @default(cuid())
  organizationId String
  key            AccountingMappingKey
  accountId      String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  account      Account      @relation(fields: [accountId], references: [id])

  @@unique([organizationId, key])
}

model AccountingPeriod {
  id             String                 @id @default(cuid())
  organizationId String
  name           String
  startDate      DateTime
  endDate        DateTime
  status         AccountingPeriodStatus @default(OPEN)
  lockedAt       DateTime?
  lockedById     String?
  closedAt       DateTime?
  closedById     String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, startDate, endDate])
  @@index([organizationId, status])
}

// Journal Entries — posted/reversed entries are immutable; corrections are
// made via reverseJournalEntry() creating a new offsetting entry, never by
// editing or deleting a posted entry's lines.
model JournalEntry {
  id             String        @id @default(cuid())
  organizationId String
  branchId       String
  entryNo        String
  entryDate      DateTime
  referenceType  String?
  referenceId    String?
  // sourceType/sourceKey back the idempotent auto-posting path — sourceKey is
  // required for system-generated entries (e.g. "BILL:{billId}:APPROVAL") and
  // left null for manually created drafts, where duplicates are expected.
  sourceType     String?
  sourceKey      String?
  description    String
  status         String        @default("draft")
  totalDebit     Decimal       @default(0) @db.Decimal(18, 2)
  totalCredit    Decimal       @default(0) @db.Decimal(18, 2)
  isBalanced     Boolean       @default(false)
  reversalOfId   String?
  reversedById   String?
  postedBy       String?
  postedAt       DateTime?
  voidReason     String?
  createdBy      String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id])
  branch         Branch        @relation(fields: [branchId], references: [id])
  lines          JournalLine[]

  @@unique([organizationId, entryNo])
  @@unique([organizationId, sourceKey])
  @@index([organizationId, status])
  @@index([organizationId, branchId, entryDate])
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  accountId      String
  description    String?
  debitAmount    Decimal      @default(0) @db.Decimal(18, 2)
  creditAmount   Decimal      @default(0) @db.Decimal(18, 2)
  lineOrder      Int          @default(0)
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([journalEntryId])
}

// Daily Sales
model DailySale {
  id                 String              @id @default(cuid())
  organizationId     String
  branchId           String
  saleNo             String
  saleDate           DateTime
  cashAmount         Float               @default(0)
  cardAmount         Float               @default(0)
  deliveryAmount     Float               @default(0)
  bankTransferAmount Float               @default(0)
  otherAmount        Float               @default(0)
  subtotal           Float
  discountAmount     Float               @default(0)
  vatAmount          Float               @default(0)
  totalAmount        Float
  refundAmount       Float               @default(0)
  netAmount          Float
  vatRate            Float               @default(15)
  status             String              @default("draft")
  notes              String?
  journalEntryId     String?
  submittedBy        String?
  submittedAt        DateTime?
  approvedBy         String?
  approvedAt         DateTime?
  voidReason         String?
  createdBy          String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organization       Organization        @relation(fields: [organizationId], references: [id])
  branch             Branch              @relation(fields: [branchId], references: [id])
  deliveryBreakdown  DeliveryBreakdown[]

  @@unique([organizationId, saleNo])
}

model DeliveryBreakdown {
  id          String    @id @default(cuid())
  dailySaleId String
  platform    String
  amount      Float
  commission  Float     @default(0)
  netAmount   Float
  dailySale   DailySale @relation(fields: [dailySaleId], references: [id], onDelete: Cascade)
}

// Cash Closing
model CashClosing {
  id                String       @id @default(cuid())
  organizationId    String
  branchId          String
  closingNo         String
  closingDate       DateTime
  openingCash       Float        @default(0)
  cashSales         Float        @default(0)
  cashExpensesPaid  Float        @default(0)
  cashDeposited     Float        @default(0)
  otherCashIn       Float        @default(0)
  otherCashOut      Float        @default(0)
  expectedCash      Float        @default(0)
  actualCashCounted Float        @default(0)
  difference        Float        @default(0)
  differenceType    String       @default("balanced")
  status            String       @default("draft")
  notes             String?
  journalEntryId    String?
  approvedBy        String?
  approvedAt        DateTime?
  createdBy         String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id])
  branch            Branch       @relation(fields: [branchId], references: [id])

  @@unique([organizationId, closingNo])
}

// Expenses
model ExpenseCategory {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  accountId      String?
  description    String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  expenses       Expense[]

  @@unique([organizationId, name])
}

model Expense {
  id                String          @id @default(cuid())
  organizationId    String
  branchId          String
  expenseNo         String
  expenseDate       DateTime
  categoryId        String
  description       String
  amount            Float
  vatAmount         Float           @default(0)
  vatRate           Float           @default(0)
  totalAmount       Float
  paymentMethod     String          @default("cash")
  supplierId        String?
  receiptDocumentId String?
  status            String          @default("draft")
  journalEntryId    String?
  submittedBy       String?
  submittedAt       DateTime?
  approvedBy        String?
  approvedAt        DateTime?
  voidReason        String?
  notes             String?
  createdBy         String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  organization      Organization    @relation(fields: [organizationId], references: [id])
  branch            Branch          @relation(fields: [branchId], references: [id])
  category          ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@unique([organizationId, expenseNo])
}

// Suppliers & Bills
model Supplier {
  id               String          @id @default(cuid())
  organizationId   String
  name             String
  tradeName        String?
  vatNumber        String?
  email            String?
  phone            String?
  address          String?
  city             String?
  accountId        String?
  creditLimit      Float           @default(0)
  paymentTermsDays Int             @default(30)
  isActive         Boolean         @default(true)
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  organization     Organization    @relation(fields: [organizationId], references: [id])
  bills            Bill[]
}

model Bill {
  id             String       @id @default(cuid())
  organizationId String
  branchId       String
  supplierId     String
  billNo         String
  supplierBillNo String?
  billDate       DateTime
  dueDate        DateTime
  subtotal       Float
  discountAmount Float        @default(0)
  vatAmount      Float        @default(0)
  totalAmount    Float
  paidAmount     Float        @default(0)
  balanceDue     Float
  status         String       @default("draft")
  notes          String?
  documentId     String?
  journalEntryId String?
  approvedBy     String?
  approvedAt     DateTime?
  voidReason     String?
  createdBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  branch         Branch       @relation(fields: [branchId], references: [id])
  supplier       Supplier     @relation(fields: [supplierId], references: [id])
  items          BillItem[]
  payments       Payment[]

  @@unique([organizationId, billNo])
}

model BillItem {
  id          String  @id @default(cuid())
  billId      String
  description String
  quantity    Float
  unitPrice   Float
  vatRate     Float   @default(0)
  vatAmount   Float   @default(0)
  totalAmount Float
  itemId      String?
  accountId   String?
  bill        Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
}

model Payment {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String
  billId         String
  paymentDate    DateTime
  amount         Float
  paymentMethod  String
  referenceNo    String?
  notes          String?
  journalEntryId String?
  createdBy      String
  createdAt      DateTime @default(now())
  bill           Bill     @relation(fields: [billId], references: [id])
}

// Inventory
// Item catalog — a category groups items and carries the default unit of
// measurement (kg, litre, gallon, ...) new items in it should use.
model ItemCategory {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?
  unit           String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  items          Item[]

  @@unique([organizationId, name])
}

model Item {
  id                 String              @id @default(cuid())
  organizationId     String
  code               String
  name               String
  description        String?
  category           String?
  categoryId         String?
  unit               String              @default("kg")
  costPrice          Float               @default(0)
  reorderPoint       Float               @default(0)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organization       Organization        @relation(fields: [organizationId], references: [id])
  itemCategory       ItemCategory?       @relation(fields: [categoryId], references: [id])
  branchStocks       BranchStock[]
  movements          StockMovement[]
  wastageItems       WastageItem[]
  purchaseOrderItems PurchaseOrderItem[]

  @@unique([organizationId, code])
}

model BranchStock {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String
  itemId         String
  quantityOnHand Float    @default(0)
  averageCost    Float    @default(0)
  totalValue     Float    @default(0)
  reorderPoint   Float    @default(0)
  lastUpdated    DateTime @default(now())
  branch         Branch   @relation(fields: [branchId], references: [id])
  item           Item     @relation(fields: [itemId], references: [id])

  @@unique([branchId, itemId])
}

model StockMovement {
  id               String   @id @default(cuid())
  organizationId   String
  branchId         String
  itemId           String
  movementType     String
  quantity         Float
  unitCost         Float    @default(0)
  totalValue       Float    @default(0)
  referenceType    String?
  referenceId      String?
  transferBranchId String?
  notes            String?
  createdBy        String
  createdAt        DateTime @default(now())
  branch           Branch   @relation(fields: [branchId], references: [id])
  item             Item     @relation(fields: [itemId], references: [id])
}

model WastageReport {
  id             String        @id @default(cuid())
  organizationId String
  branchId       String
  reportDate     DateTime
  totalValue     Float         @default(0)
  status         String        @default("draft")
  notes          String?
  journalEntryId String?
  approvedBy     String?
  approvedAt     DateTime?
  createdBy      String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  branch         Branch        @relation(fields: [branchId], references: [id])
  items          WastageItem[]
}

model WastageItem {
  id              String        @id @default(cuid())
  wastageReportId String
  itemId          String
  quantity        Float
  unitCost        Float
  totalValue      Float
  reason          String?
  wastageReport   WastageReport @relation(fields: [wastageReportId], references: [id], onDelete: Cascade)
  item            Item          @relation(fields: [itemId], references: [id])
}

// Purchase Orders
model PurchaseOrder {
  id                   String              @id @default(cuid())
  organizationId       String
  branchId             String
  poNo                 String
  orderDate            DateTime
  expectedDeliveryDate DateTime?
  subtotal             Float               @default(0)
  vatAmount            Float               @default(0)
  totalAmount          Float               @default(0)
  status               String              @default("draft")
  notes                String?
  rejectionReason      String?
  voidReason           String?
  submittedBy          String?
  submittedAt          DateTime?
  approvedBy           String?
  approvedAt           DateTime?
  receivedBy           String?
  receivedAt           DateTime?
  createdBy            String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  organization         Organization        @relation(fields: [organizationId], references: [id])
  branch               Branch              @relation(fields: [branchId], references: [id])
  items                PurchaseOrderItem[]

  @@unique([organizationId, poNo])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  itemId          String?
  description     String
  quantity        Float
  unitCost        Float         @default(0)
  vatRate         Float         @default(0)
  vatAmount       Float         @default(0)
  totalCost       Float         @default(0)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item            Item?         @relation(fields: [itemId], references: [id])
}

// Documents
model Document {
  id               String       @id @default(cuid())
  organizationId   String
  branchId         String
  originalFilename String
  storedFilename   String
  filePath         String
  fileType         String
  fileSize         Int
  documentType     String       @default("other")
  ocrStatus        String       @default("pending")
  extractedData    Json?
  linkedType       String?
  linkedId         String?
  uploadedBy       String
  createdAt        DateTime     @default(now())
  organization     Organization @relation(fields: [organizationId], references: [id])
}

// Notifications
model Notification {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  type           String       @default("info")
  title          String
  message        String
  link           String?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Audit Logs
model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  branchId       String?
  userId         String
  userEmail      String
  userName       String
  action         String
  module         String
  resourceType   String?
  resourceId     String?
  resourceRef    String?
  oldData        Json?
  newData        Json?
  ipAddress      String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, module])
  @@index([organizationId, resourceType, resourceId])
}
