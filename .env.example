DATABASE_URL="postgresql://postgres:password@localhost:5432/zaitoon_db"
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-32-chars"
PORT=4000
NODE_ENV=development

# Super Admin bootstrap / recovery — applied on every server start when both
# EMAIL and PASSWORD are set. Creates the user if missing, otherwise makes sure
# it is active, holds the Super Admin role and can access all branches.
# An existing user's password is only overwritten when RESET_PASSWORD=true
# (use that to recover a forgotten password, then set it back to false).
# ORG_ID is only needed if the database has more than one organization.
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""
SUPER_ADMIN_FIRST_NAME="Super"
SUPER_ADMIN_LAST_NAME="Admin"
SUPER_ADMIN_RESET_PASSWORD=false
SUPER_ADMIN_ORG_ID=""

# Shared secret required by /sync/export. Must match SYNC_SECRET on any
# deployment that fetches data from this one (e.g. a second-branch instance).
SYNC_SECRET=""
